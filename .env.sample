# samle configuration for bashi
# rename this to .env for configuration (DO NOT CUSTOMIZE THIS FILE)

# The ZFS Pool Name where the target dataset resides (e.g., 'tank', 'pool1')
ZFS_POOL_NAME="your_pool_name"

# The base path where your ZFS volume is mounted *inside* the Docker container.
# This is used to map the client's absolute server path to the container's accessible path.
# Example: if the remote /mnt/pool/data is mapped to /data, this should be /mnt/pool/data.
ZFS_SERVER_MOUNT_ROOT="/mnt/your_pool/your_dataset_mount"

# The port BASHI runs on. Host should remain 0.0.0.0 for Docker compatibility.
BASHI_HOST="0.0.0.0"
BASHI_PORT=5001
